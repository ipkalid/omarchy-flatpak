#!/usr/bin/env bash
# Read-only probe; works without Python or Flatpak installed.
set -eu
printf '{'
separator=''
for dependency in flatpak brew mise fzf python3 timeout xdg-terminal-exec; do
  available=false
  if command -v "$dependency" >/dev/null 2>&1; then available=true; fi
  printf '%s"%s":%s' "$separator" "$dependency" "$available"
  separator=,
done
printf '}\n'
